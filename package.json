{
  "name": "dsh-memory-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Unified DSH memory bundle: instant session memory (gateway) + fail-closed WeKnora knowledge pilot + retained WeKnora sidebar panel. Merges three former plugins.",
  "type": "module",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {}
}
